{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "content-security-policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://doxomachy.matlabdec12.workers.dev; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" },
        { "key": "x-content-type-options", "value": "nosniff" },
        { "key": "referrer-policy", "value": "no-referrer" },
        { "key": "permissions-policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "cache-control", "value": "no-store" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "cache-control", "value": "no-store" }
      ]
    }
  ]
}
