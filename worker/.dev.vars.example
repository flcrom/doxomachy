# Copy to worker/.dev.vars for local `wrangler dev`. Never commit real values.
# Use sandbox/test credentials locally. Production secrets belong in the
# Cloudflare Worker secret store (`wrangler secret put`), never in this file.

# Magic-link email
RESEND_API_KEY=re_replace-with-test-api-key
AUTH_EMAIL_PEPPER=replace-with-32-or-more-random-bytes
AUTH_FROM=Doxomachy <login@doxomachy.flcrom.dev>

# Dodo sandbox
DODO_API_KEY=replace-with-test-mode-api-key
DODO_WEBHOOK_SECRET=whsec_replace-with-test-mode-webhook-signing-secret
DODO_ADMIN_KEY=replace-with-long-random-operator-key
